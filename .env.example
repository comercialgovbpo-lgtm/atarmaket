# ====================================================================
# AtaMarket — variáveis de ambiente (copie para .env.local)
# Nunca exponha chaves secretas no frontend: nenhuma variável abaixo
# usa o prefixo NEXT_PUBLIC_, exceto o nome da aplicação.
# ====================================================================
NEXT_PUBLIC_APP_NAME=AtaMarket
APP_URL=http://localhost:3000

# Banco PostgreSQL (Supabase ou equivalente)
# DATABASE_URL: papel da aplicação SEM BYPASSRLS, membro de app_runtime (RLS efetivo)
DATABASE_URL=postgres://atamarket_app:SENHA@localhost:5432/atamarket
# DATABASE_ADMIN_URL: papel proprietário, usado apenas pelas migrações e scripts
DATABASE_ADMIN_URL=postgres://atamarket_owner:SENHA@localhost:5432/atamarket
DATABASE_SSL=false
DB_POOL_MAX=10

# Rotinas agendadas (Vercel Cron envia Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=gere-um-valor-aleatorio-longo

# Armazenamento de documentos: local | supabase (bucket PRIVADO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ata-documents

# Extração de documentos com IA (opcional; sem chave usa extração por padrões de texto)
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5-5

# Pagamentos: none | stripe | mercadopago  (nenhum pagamento é simulado)
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# E-mail transacional (fila email_outbox; envio via Resend quando configurado)
RESEND_API_KEY=
EMAIL_FROM="AtaMarket <nao-responda@seu-dominio.com.br>"

# PNCP (padrão: https://pncp.gov.br)
PNCP_BASE_URL=https://pncp.gov.br
